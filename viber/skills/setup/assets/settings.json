{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "showClearContextOnPlanAccept": true,
  "subagentDefaults": {
    "inheritParentPermissions": true
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableAutoMode": "disable",
    "allow": [
      "Agent",
      "AskUserQuestion",
      "Bash",
      "BashOutput",
      "Edit(**/*)",
      "EnterPlanMode",
      "EnterWorktree",
      "ExitPlanMode",
      "ExitWorktree",
      "Glob",
      "Grep",
      "KillShell",
      "LSP",
      "ListAgents",
      "ListMcpResourcesTool",
      "Monitor",
      "NotebookEdit",
      "Read",
      "ReadMcpResourceDirTool",
      "ReadMcpResourceTool",
      "SendMessage",
      "Skill",
      "Task",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskOutput",
      "TaskStop",
      "TaskUpdate",
      "TodoWrite",
      "ToolSearch",
      "WebFetch",
      "WebSearch",
      "Write(**/*)"
    ],
    "ask": [
      "Bash(docker system prune:*)",
      "Bash(find * -delete*)",
      "Bash(find * -exec rm *)",
      "Bash(gh pr close:*)",
      "Bash(gh pr merge:*)",
      "Bash(git * --force*)",
      "Bash(git -c *)",
      "Bash(git branch -D:*)",
      "Bash(git branch -d:*)",
      "Bash(git checkout:*)",
      "Bash(git clean:*)",
      "Bash(git rebase:*)",
      "Bash(git reset --hard:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git switch:*)",
      "Bash(git tag -d:*)",
      "Bash(git worktree:*)",
      "Bash(rm *-f *-r*)",
      "Bash(rm *-fr*)",
      "Bash(rm *-r *-f*)",
      "Bash(rm *-rf*)",
      "Bash(rm -fr:*)",
      "Bash(rm -rf:*)",
      "Edit(**/.env.*)",
      "Read(**/.env.*)",
      "Read(./.env.*)"
    ],
    "deny": [
      "Bash(aws:*)",
      "Bash(az:*)",
      "Bash(chmod *777*)",
      "Bash(dd:*)",
      "Bash(dotnet nuget push:*)",
      "Bash(gcloud:*)",
      "Bash(gh api --method DELETE:*)",
      "Bash(gh api -X DELETE:*)",
      "Bash(gh auth login:*)",
      "Bash(gh auth logout:*)",
      "Bash(gh auth token:*)",
      "Bash(gh issue delete:*)",
      "Bash(gh release delete:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh secret:*)",
      "Bash(git config --global:*)",
      "Bash(git config --system:*)",
      "Bash(git filter-branch:*)",
      "Bash(git gc --prune:*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f *)",
      "Bash(git push * -f)",
      "Bash(git push --delete:*)",
      "Bash(git push --force:*)",
      "Bash(git push --mirror:*)",
      "Bash(git push -f:*)",
      "Bash(git reflog expire:*)",
      "Bash(git update-ref -d:*)",
      "Bash(kubectl delete:*)",
      "Bash(mkfs:*)",
      "Bash(npm login:*)",
      "Bash(npm publish:*)",
      "Bash(pnpm publish:*)",
      "Bash(reboot:*)",
      "Bash(rm -r /:*)",
      "Bash(rmdir /s:*)",
      "Bash(shutdown:*)",
      "Bash(sudo:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(yarn publish:*)",
      "Edit(**/.env)",
      "Edit(./.env)",
      "Edit(./.git/**)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/*.pfx)",
      "Read(**/.env)",
      "Read(**/.npmrc)",
      "Read(**/id_rsa*)",
      "Read(./.env)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.ssh/**)"
    ]
  }
}
