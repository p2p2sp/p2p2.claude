{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Agent",
      "Bash",
      "Edit",
      "Glob",
      "Grep",
      "LSP",
      "Read",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskOutput",
      "TaskStop",
      "TaskUpdate",
      "ToolSearch",
      "WebFetch",
      "WebSearch",
      "Write",
      "Skill",
      "mcp__playwright__*",
      "mcp__plugin_playwright_playwright__*",
      "mcp__context7__*",
      "mcp__plugin_context7_context7__*",
      "mcp__dotnet__*",
      "mcp__plugin_microsoft-docs_microsoft-learn__*"
    ],
    "deny": [
      "ScheduleWakeup",
      "ReportFindings",
      "CronCreate",
      "CronList",
      "CronDelete",
      "SendMessage",
      "NotebookEdit",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf .)",
      "Bash(rm -rf ./*)",
      "Bash(rm -rf ..)",
      "Bash(rm -rf ../)",
      "Bash(rm -rf $HOME)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(su -)",
      "Bash(doas *)",
      "Bash(pkexec *)",
      "Bash(chmod 777 *)",
      "Bash(chmod -R 777 *)",
      "Bash(chmod a+rwx *)",
      "Bash(chown *)",
      "Bash(chgrp *)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Bash(mkfs.*)",
      "Bash(fdisk *)",
      "Bash(parted *)",
      "Bash(mount *)",
      "Bash(umount *)",
      "Bash(fsck *)",
      "Bash(shutdown *)",
      "Bash(reboot *)",
      "Bash(poweroff *)",
      "Bash(halt *)",
      "Bash(init *)",
      "Bash(systemctl *)",
      "Bash(service *)",
      "Bash(kill *)",
      "Bash(killall *)",
      "Bash(pkill *)",
      "Bash(iptables *)",
      "Bash(ufw *)",
      "Bash(nft *)",
      "Bash(firewall-cmd *)",
      "Bash(useradd *)",
      "Bash(userdel *)",
      "Bash(usermod *)",
      "Bash(groupadd *)",
      "Bash(groupdel *)",
      "Bash(passwd *)",
      "Bash(visudo *)",
      "Bash(crontab *)",
      "Bash(at *)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(netcat *)",
      "Bash(nmap *)",
      "Bash(tcpdump *)",
      "Bash(wireshark *)",
      "Bash(ettercap *)",
      "Bash(arp *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(sftp *)",
      "Bash(ftp *)",
      "Bash(eval *)",
      "Bash(exec *)",
      "Bash(bash -c *)",
      "Bash(sh -c *)",
      "Bash(zsh -c *)",
      "Bash(apt *)",
      "Bash(apt-get *)",
      "Bash(dpkg *)",
      "Bash(yum *)",
      "Bash(dnf *)",
      "Bash(pacman *)",
      "Bash(snap *)",
      "Bash(flatpak *)",
      "Bash(brew *)",
      "Bash(history *)",
      "Bash(cat ~/.bash_history*)",
      "Bash(cat ~/.zsh_history*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.env.production)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/id_rsa*)",
      "Read(./**/id_ed25519*)",
      "Read(./**/id_ecdsa*)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/credentials)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.azure/**)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(/etc/shadow)",
      "Read(/etc/passwd)",
      "Read(/etc/sudoers)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./secrets/**)",
      "Edit(./**/*.pem)",
      "Edit(./**/*.key)",
      "Edit(~/.ssh/**)"
    ],
    "defaultMode": "acceptEdits"
  },
  "disableBundledSkills": true,
  "disableWorkflows": true,
  "disableRemoteControl": false,
  "disableClaudeAiConnectors": true,
  "disableArtifact": true
}