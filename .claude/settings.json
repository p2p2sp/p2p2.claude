{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "disableWorkflows": true,
  "disableRemoteControl": true,
  "modelOverrides": {
    "default": "claude-opus-4-8",
    "opus": "claude-opus-4-8"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "additionalDirectories": [
      "C:/Users/dariu/.claude-p2p2/plugins"
    ],
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "NotebookEdit",
      "Skill",
      "Agent",
      "Task",
      "TaskCreate",
      "TaskUpdate",
      "TaskGet",
      "TaskList",
      "TaskStop",
      "TaskOutput",
      "TodoWrite",
      "AskUserQuestion",
      "ExitPlanMode",
      "EnterPlanMode",
      "Bash",
      "BashOutput",
      "KillShell",
      "ToolSearch",
      "WebSearch",
      "WebFetch",
      "LSP",
      "Monitor",
      "SendMessage",
      "ListAgents",
      "EnterWorktree",
      "ExitWorktree",
      "ListMcpResourcesTool",
      "ReadMcpResourceTool",
      "ReadMcpResourceDirTool",
      "mcp__plugin_microsoft-docs_microsoft-learn"
    ],
    "ask": [],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -r /:*)",
      "Bash(rmdir /s:*)",
      "Bash(sudo:*)",
      "Bash(dd:*)",
      "Bash(mkfs:*)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(chmod 777:*)",
      "Bash(chmod -R 777:*)",

      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --delete:*)",
      "Bash(git push --mirror:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git checkout .)",
      "Bash(git checkout --:*)",
      "Bash(git restore:*)",
      "Bash(git rebase:*)",
      "Bash(git filter-branch:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -d:*)",
      "Bash(git tag -d:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)",
      "Bash(git update-ref -d:*)",
      "Bash(git reflog expire:*)",
      "Bash(git gc --prune:*)",
      "Bash(git config --global:*)",
      "Bash(git config --system:*)",

      "Bash(gh repo delete:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh issue delete:*)",
      "Bash(gh release delete:*)",
      "Bash(gh secret:*)",
      "Bash(gh auth login:*)",
      "Bash(gh auth logout:*)",
      "Bash(gh auth token:*)",
      "Bash(gh api --method DELETE:*)",
      "Bash(gh api -X DELETE:*)",

      "Bash(npm publish:*)",
      "Bash(pnpm publish:*)",
      "Bash(yarn publish:*)",
      "Bash(npm login:*)",
      "Bash(dotnet nuget push:*)",
      "Bash(docker system prune:*)",
      "Bash(kubectl delete:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(aws:*)",
      "Bash(az:*)",
      "Bash(gcloud:*)",

      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Edit(./.env)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(./.git/**)",
      "Write(./.git/**)",
      "Edit(~/.claude-p2p2/**)",
      "Write(~/.claude-p2p2/**)"
    ]
  }
}
