{
  "schemaVersion": "v6",
  "generateName": true,
  "tags": [{"key": "team", "value": "platform"}],
  "spec": {
    "display": {"name": "Logs overview", "description": "Log volume and errors per service"},
    "duration": "1h",
    "variables": [
      {"kind": "ListVariable", "spec": {"name": "service", "display": {"name": "service"}, "allowMultiple": true, "allowAllValue": true, "sort": "alphabetical-asc",
        "plugin": {"kind": "signoz/DynamicVariable", "spec": {"name": "service.name", "signal": "logs"}}}}
    ],
    "panels": {
      "logs-count": {
        "kind": "Panel",
        "spec": {
          "display": {"name": "Log count by severity"},
          "plugin": {"kind": "signoz/TimeSeriesPanel", "spec": {"legend": {"position": "bottom"}}},
          "queries": [{"kind": "time_series", "spec": {"name": "A", "plugin": {"kind": "signoz/BuilderQuery", "spec": {
            "name": "A", "signal": "logs", "stepInterval": 60,
            "aggregations": [{"expression": "count()"}],
            "filter": {"expression": "service.name IN $service"},
            "groupBy": [{"name": "severity_text", "fieldContext": "log", "fieldDataType": "string"}],
            "order": [{"key": {"name": "count()"}, "direction": "desc"}],
            "limit": 10,
            "legend": "{{severity_text}}"}}}}]
        }
      },
      "errors-total": {
        "kind": "Panel",
        "spec": {
          "display": {"name": "Errors"},
          "plugin": {"kind": "signoz/NumberPanel", "spec": {}},
          "queries": [{"kind": "scalar", "spec": {"name": "A", "plugin": {"kind": "signoz/BuilderQuery", "spec": {
            "name": "A", "signal": "logs",
            "aggregations": [{"expression": "count()"}],
            "filter": {"expression": "severity_number >= 17 AND service.name IN $service"}}}}}]
        }
      },
      "error-list": {
        "kind": "Panel",
        "spec": {
          "display": {"name": "Recent errors"},
          "plugin": {"kind": "signoz/ListPanel", "spec": {}},
          "queries": [{"kind": "raw", "spec": {"name": "A", "plugin": {"kind": "signoz/BuilderQuery", "spec": {
            "name": "A", "signal": "logs",
            "filter": {"expression": "severity_number >= 17 AND service.name IN $service"},
            "order": [{"key": {"name": "timestamp"}, "direction": "desc"}, {"key": {"name": "id"}, "direction": "desc"}],
            "limit": 100}}}}]
        }
      }
    },
    "layouts": [
      {"kind": "Grid", "spec": {"items": [
        {"x": 0, "y": 0, "width": 8, "height": 6, "content": {"$ref": "#/spec/panels/logs-count"}},
        {"x": 8, "y": 0, "width": 4, "height": 6, "content": {"$ref": "#/spec/panels/errors-total"}},
        {"x": 0, "y": 6, "width": 12, "height": 8, "content": {"$ref": "#/spec/panels/error-list"}}
      ]}}
    ]
  }
}
